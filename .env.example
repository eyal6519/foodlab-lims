# Copy this file to .env and fill in the values.
# VITE_* variables are inlined into the public browser bundle by Vite.

# Project URL from the Supabase dashboard (Settings > API)
VITE_SUPABASE_URL=

# Publishable anon key from the Supabase dashboard (Settings > API).
# This is PUBLIC by design and safe to expose to the browser.
VITE_SUPABASE_ANON_KEY=

# SECURITY WARNING — DO NOT set this variable:
# The service role key bypasses Row Level Security and must NEVER be inlined
# into the client bundle. From .env it would leak to every visitor via the
# built app. The production build FAILS if this variable is present.
# If QA seeding needs a service-role key in local development, set it ONLY in
# a local .env.development and never in .env.production.
# VITE_SUPABASE_SERVICE_ROLE_KEY=